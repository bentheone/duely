MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/duely
JWT_SECRET=change-me-64-random-chars
JWT_REFRESH_SECRET=change-me-another-64-random-chars
# 32 bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=
OWNER_CLOUDINARY_CLOUD_NAME=
OWNER_CLOUDINARY_API_KEY=
OWNER_CLOUDINARY_API_SECRET=
OWNER_EMAIL=
PORT=3000

# Admins (in addition to OWNER_EMAIL) who see the in-app Admin dashboard. Comma-separated.
ADMIN_EMAILS=
# SMTP for "you're in" emails to testers and new-request alerts to admins.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-char app password from myaccount.google.com/apppasswords> (needs 2-Step Verification).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Duely <you@gmail.com>"
# Link in the "you're in" email (e.g. the latest APK on GitHub Releases or EAS).
APP_DOWNLOAD_URL=
