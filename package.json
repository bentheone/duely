{
  "name": "duely",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build:shared": "pnpm --filter @duely/shared build",
    "typecheck": "pnpm build:shared && pnpm -r --parallel typecheck",
    "test": "pnpm build:shared && pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "22",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0"
  }
}
